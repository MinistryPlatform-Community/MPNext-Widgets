# Dependencies
node_modules/

# Build outputs
.next/
packages/types/dist/
packages/embed-sdk/dist/
packages/types/src/*.js
packages/types/src/*.d.ts
packages/types/src/*.d.ts.map

# SDK build artifacts in public (loader + hashed bundles + hashed CSS)
public/embed-sdk/next-embed.js
public/embed-sdk/next-embed.*.js
public/embed-sdk/next-embed.*.js.map
# Lazy locale catalogue chunks. Separate patterns because the name uses a
# hyphen (next-embed-locale-es.<hash>.js), which `next-embed.*.js` misses.
public/embed-sdk/next-embed-locale-*.js
public/embed-sdk/next-embed-locale-*.js.map
public/embed-sdk/mp-widget-overrides.*.css
!public/embed-sdk/mp-widget-overrides.css

# Environment
.env
.env*.local

# IDE
.vs/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# OS
.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo
# Generated by `next dev` / `next build` / `next typegen`; Next.js docs say not to
# track it. Its body flips between `.next/types/` and `.next/dev/types/` depending on
# which command ran last. See .claude/TODO/README.md (item 33).
next-env.d.ts

# Testing
test-results/
playwright-report/
blob-report/
.playwright-mcp/
screenshots/
coverage/

# Vercel
.vercel

# MCP config
.mcp.json

# Logs
*.log
