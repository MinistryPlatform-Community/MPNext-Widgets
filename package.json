{
  "name": "mpnext-widgets",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "preinstall": "npx -y only-allow pnpm",
    "dev:next": "next dev",
    "dev:sdk": "pnpm --filter @mpnext/embed-sdk dev",
    "dev": "concurrently -n next,widget -c blue,green \"next dev\" \"pnpm --filter @mpnext/embed-sdk demo\"",
    "test:widget": "concurrently -n next,widget -c blue,green \"next dev\" \"pnpm --filter @mpnext/embed-sdk demo\"",
    "build": "pnpm build:sdk && next build",
    "build:web": "next build",
    "build:sdk": "pnpm --filter @mpnext/embed-sdk build && node scripts/hash-sdk.js && node scripts/copy-sdk.js",
    "start": "next start",
    "lint": "eslint .",
    "mp:generate": "tsx src/lib/providers/ministry-platform/scripts/generate-types.ts",
    "mp:generate:models": "tsx src/lib/providers/ministry-platform/scripts/generate-types.ts -o src/lib/providers/ministry-platform/models --zod --clean",
    "dev:demo": "pnpm build:sdk && next dev",
    "setup": "node scripts/setup-bootstrap.mjs",
    "setup:check": "node scripts/setup-bootstrap.mjs --check",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:widget": "playwright test --project=widget"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "better-auth": "^1.7.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "jose": "^6.2.12",
    "lucide-react": "^1.41.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.13",
    "zod": "^4.5.4"
  },
  "pnpm": {
    "overrides": {
      "cookie": ">=0.7.0",
      "defu": ">=6.1.7",
      "minimatch@3>brace-expansion": ">=1.1.18 <2",
      "postcss": ">=8.5.28",
      "kysely": "^0.28.17"
    },
    "patchedDependencies": {
      "@better-auth/core@1.7.3": "patches/@better-auth__core@1.7.3.patch"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "better-auth>vitest": "5"
      }
    }
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.7.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "autoprefixer": "^10.5.5",
    "chalk": "^6.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-config-next": "^16.3.4",
    "jsdom": "^30.0.1",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.29.3+sha512.498e1fb4cca5aa06c1dcf2611e6fafc50972ffe7189998c409e90de74566444298ffe43e6cd2acdc775ba1aa7cc5e092a8b7054c811ba8c5770f84693d33d2dc"
}
