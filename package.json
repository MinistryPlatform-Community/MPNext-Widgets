{
  "name": "mpnext-widgets",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "preinstall": "npx -y only-allow pnpm",
    "dev:next": "next dev",
    "dev:sdk": "pnpm --filter @mpnext/embed-sdk dev",
    "dev": "concurrently -n next,widget -c blue,green \"next dev\" \"pnpm --filter @mpnext/embed-sdk demo\"",
    "test:widget": "concurrently -n next,widget -c blue,green \"next dev\" \"pnpm --filter @mpnext/embed-sdk demo\"",
    "build": "pnpm build:sdk && next build",
    "build:web": "next build",
    "build:sdk": "pnpm --filter @mpnext/embed-sdk build && node scripts/hash-sdk.js && node scripts/copy-sdk.js",
    "start": "next start",
    "lint": "eslint .",
    "mp:generate": "tsx src/lib/providers/ministry-platform/scripts/generate-types.ts",
    "mp:generate:models": "tsx src/lib/providers/ministry-platform/scripts/generate-types.ts -o src/lib/providers/ministry-platform/models --zod --clean",
    "dev:demo": "pnpm build:sdk && next dev",
    "setup": "node scripts/setup-bootstrap.mjs",
    "setup:check": "node scripts/setup-bootstrap.mjs --check",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:widget": "playwright test --project=widget --project=widget-legacy --project=widget-dual",
    "i18n:check": "tsx scripts/i18n-check.mjs",
    "i18n:sync": "tsx scripts/i18n-check.mjs --sync"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-dialog": "^1.3.0",
    "@radix-ui/react-dropdown-menu": "^2.2.0",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.0",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.55.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.6"
  },
  "pnpm": {
    "overrides": {
      "cookie": ">=0.7.0",
      "defu": ">=6.1.7",
      "minimatch@3>brace-expansion": ">=1.1.21 <2",
      "minimatch@10>brace-expansion": ">=5.0.12 <6",
      "source-map-js": ">=1.2.2 <2",
      "postcss": ">=8.5.28",
      "kysely": "^0.28.17"
    },
    "patchedDependencies": {
      "@better-auth/core@1.7.7": "patches/@better-auth__core@1.7.7.patch"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint-plugin-react>eslint": "10",
        "eslint-plugin-import>eslint": "10",
        "eslint-plugin-jsx-a11y>eslint": "10"
      }
    }
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.7.3",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "autoprefixer": "^10.6.1",
    "chalk": "^6.0.1",
    "concurrently": "^10.0.6",
    "dotenv": "^18.0.7",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.0",
    "jsdom": "^30.1.2",
    "playwright": "^1.64.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.29.3+sha512.498e1fb4cca5aa06c1dcf2611e6fafc50972ffe7189998c409e90de74566444298ffe43e6cd2acdc775ba1aa7cc5e092a8b7054c811ba8c5770f84693d33d2dc"
}
