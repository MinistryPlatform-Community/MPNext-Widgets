# ============================================================================
# Better Auth (OAuth login)
# ============================================================================
# Generate secret via: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=your-better-auth-secret-min-32-chars

# ============================================================================
# OIDC Provider (Ministry Platform OAuth — interactive user login)
# ============================================================================
# Credentials for the OAuth client used to sign users in. If unset, the code
# falls back to MINISTRY_PLATFORM_CLIENT_ID / _SECRET below (src/lib/auth.ts),
# so you only need these if your login client differs from the API client.
OIDC_CLIENT_ID=your-oidc-client-id
OIDC_CLIENT_SECRET=your-oidc-client-secret

# ============================================================================
# Ministry Platform API (service-to-service / client credentials)
# ============================================================================
# Base URL must include the /ministryplatformapi suffix; server code strips it
# where a bare host is needed (src/lib/embed/config.ts). Required by the type
# generator (pnpm generate:types) and all MP-backed services.
MINISTRY_PLATFORM_BASE_URL=https://your-mp-instance.com/ministryplatformapi
MINISTRY_PLATFORM_CLIENT_ID=your-client-id
MINISTRY_PLATFORM_CLIENT_SECRET=your-client-secret

# Organization display name baked into the embed SDK at build time (e.g. the
# SMS opt-in consent text in the profile widget). Unset falls back to a neutral
# phrase ("our organization"). Consumed by Vite at build (packages/embed-sdk).
VITE_ORG_NAME=

# ============================================================================
# Public Keys (exposed to the browser)
# ============================================================================
NEXT_PUBLIC_MINISTRY_PLATFORM_FILE_URL=https://your-mp-instance.com/ministryplatformapi/files
NEXT_PUBLIC_APP_NAME=MPNext-Widgets

# NEXT_PUBLIC_APP_VERSION is NOT set here — it is derived automatically at build
# time from the repo's VERSION file (next.config.ts), defaulting to "dev".
# Setting it manually has no effect.

# ============================================================================
# Embed Widget Settings
# ============================================================================
# EMBED_JWT_SECRET: Signs short-lived widget JWTs (5-min expiry) and the
# OAuth state cookie set by /api/embed/auth/login. Required in production; a
# dev-only fallback is used when unset outside production.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
EMBED_JWT_SECRET=

# Comma-separated origins allowed to call the embed API.
# On Vercel, VERCEL_URL and VERCEL_PROJECT_PRODUCTION_URL (injected
# automatically by the platform) are also added to the allowlist — no need to
# set those yourself locally.
EMBED_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Widget auth mode (README "Widget Authentication"; WIDGET-AUTH-MIGRATION-PLAN.md)
# EMBED_AUTH_MODE: legacy | dual | hardened. Default: legacy. Invalid → legacy.
#   legacy   — /api/embed/session accepts the MP token written by MPWidgets.js
#              (mpUserToken) only; <next-user-menu> renders <mpp-user-login>.
#   dual     — accepts a server session id (sid) OR mpUserToken; widgets render
#              their own Sign In; a valid legacy token is silently upgraded to
#              a server session once. Use this while migrating a customer.
#   hardened — sid only; mpUserToken is ignored and MP tokens never reach the
#              browser. Requires the redirect URI below to be registered in MP.
EMBED_AUTH_MODE=legacy

# Per-origin override, comma-separated origin=mode pairs. Wins over
# EMBED_AUTH_MODE for that origin. Lets one deployment serve customers in
# different modes. Example:
#   https://www.church.org=hardened,https://other.church=legacy,http://localhost:5173=dual
EMBED_AUTH_MODE_ORIGINS=

# Widget JWT `iss` / `aud` claims (verified on every widget request).
# Defaults: mpnext-embed / mpnext-embed-api. Only change if several widget
# hosts share one EMBED_JWT_SECRET and must not accept each other's tokens.
EMBED_JWT_ISSUER=
EMBED_JWT_AUDIENCE=

# EMBED_SESSION_ENC_KEY: AES-256-GCM key (32 bytes, base64url) that encrypts
# MP access/refresh/id tokens at rest in the session store. Required in
# production when EMBED_AUTH_MODE (or any origin override) is not legacy;
# otherwise derived from SHA-256(EMBED_JWT_SECRET). Keep it distinct from
# EMBED_JWT_SECRET so a leaked signing key does not decrypt stored tokens.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
EMBED_SESSION_ENC_KEY=

# Session store — Upstash Redis REST URL + token (src/lib/embed/session-store.ts).
# Unset → in-memory store: fine for dev/tests, but sessions are lost on restart
# and are not shared across serverless instances (a warning is logged in
# production). Required in production for dual/hardened.
EMBED_SESSION_STORE_URL=
EMBED_SESSION_STORE_TOKEN=

# Server-session lifetimes in seconds. Idle is sliding (bumped on use, at most
# once a minute); absolute is a hard cap from sign-in. Defaults: 2592000 (30d)
# and 7776000 (90d). Keep absolute <= the MP refresh-token lifetime.
EMBED_SESSION_IDLE_TTL=
EMBED_SESSION_ABSOLUTE_TTL=

# Public origin of THIS widget host (no trailing slash), used to build the
# OAuth redirect_uri (${EMBED_PUBLIC_URL}/api/embed/auth/callback) and the
# login/logout URLs returned by /api/embed/auth/config. Unset → derived from
# the incoming request URL. Set it when a proxy/CDN rewrites the Host header.
EMBED_PUBLIC_URL=

# Send a PKCE code_challenge on the widget login flow (true/false). Default
# false, matching src/lib/auth.ts (`pkce: false`). Enable only if the MP OAuth
# client used by OIDC_CLIENT_ID accepts PKCE.
EMBED_OAUTH_PKCE=

# Requests per minute per client IP on the unauthenticated widget routes
# (/api/embed/session, /api/embed/auth/exchange). Default 120. Counted in the
# session store (see EMBED_SESSION_STORE_URL).
EMBED_SESSION_RATE_LIMIT=

# ============================================================================
# reCAPTCHA (optional — server-side verification of widget submissions)
# ============================================================================
# If unset, server-side reCAPTCHA verification is skipped (dev mode).
# See src/lib/embed/recaptcha.ts.
RECAPTCHA_SECRET_KEY=

# ============================================================================
# Demo Access Control (src/app/(demo)/...)
# ============================================================================
# Comma-separated MP User_Group_ID values whose members can view /demo pages.
# No default — set this to your own staff/admin group(s). If unset (and
# DEMO_PUBLIC_ACCESS is not enabled), group-based demo access is denied.
DEMO_ACCESS_GROUP_IDS=

# Set to "true" or "authenticated" to grant any signed-in user access to /demo
# without group membership. Useful for Vercel preview deploys and internal QA.
DEMO_PUBLIC_ACCESS=

# ============================================================================
# Full Calendar Admin (src/services/fullCalendarService.ts)
# ============================================================================
# Comma-separated MP User_Group_ID values whose members are treated as
# calendar admins. No default — set this for your tenant. If unset, no users
# are treated as calendar admins.
CALENDAR_ADMIN_GROUP_IDS=

# ============================================================================
# Playwright E2E (only needed to run `pnpm test:e2e`)
# ============================================================================
# A non-admin MP OAuth user with MFA disabled.
PLAYWRIGHT_MP_USERNAME=
PLAYWRIGHT_MP_PASSWORD=
